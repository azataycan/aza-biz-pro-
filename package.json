{
  "name": "aza-biz-pro",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create aza-biz-pro-db",
    "db:migrate:local": "wrangler d1 migrations apply aza-biz-pro-db --local",
